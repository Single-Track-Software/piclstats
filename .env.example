PICLSTATS_DATABASE_URL=postgresql+psycopg://localhost:5432/piclstats
PICLSTATS_SCRAPE_DELAY_SECONDS=1.5
PICLSTATS_LOG_LEVEL=INFO

# Signs the session cookie. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required whenever PICLSTATS_SESSION_HTTPS_ONLY is true — the app refuses to
# start without it rather than fall back to a guessable key.
PICLSTATS_SESSION_SECRET=change-me
# Set False for local http dev (otherwise the Secure cookie won't be sent, and
# an unset secret is tolerated with a random per-process key). Leave True in production.
PICLSTATS_SESSION_HTTPS_ONLY=true

# Bootstrap admin: on startup, if no user with this email exists, one is created
# with this email/password and the 'admin' role. Safe to leave set afterward.
PICLSTATS_ADMIN_EMAIL=admin@example.com
PICLSTATS_ADMIN_PASSWORD=change-me
